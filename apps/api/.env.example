# ==============================================================================
# PAYCREW BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
API_PREFIX=api

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=paycrew_dev
# Optional full connection URI (e.g. postgresql://user:pass@host:5432/db)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/paycrew_dev

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & KYC ENCRYPTION)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_access_secret_min_16_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
KYC_ENCRYPTION_KEY=01234567890123456789012345678901

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 AUTHENTICATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 5. QUIDAX RAMP (ON-RAMP, OFF-RAMP & REAL-TIME QUOTE ENGINE)
# ------------------------------------------------------------------------------
QUIDAX_RAMP_BASE_URL=https://ramp-be.quidax.io
QUIDAX_RAMP_PRIVATE_KEY=your_quidax_ramp_private_key
QUIDAX_RAMP_PUBLIC_KEY=your_quidax_ramp_public_key
QUIDAX_RAMP_WEBHOOK_SECRET=your_quidax_ramp_webhook_secret

# ------------------------------------------------------------------------------
# 6. KORAPAY (NAIRA VIRTUAL ACCOUNTS & BANK SETTLEMENT)
# ------------------------------------------------------------------------------
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api
KORAPAY_SECRET_KEY=sk_test_your_korapay_secret_key
KORAPAY_PUBLIC_KEY=pk_test_your_korapay_public_key
KORAPAY_WEBHOOK_SECRET=your_korapay_webhook_secret

# ------------------------------------------------------------------------------
# 7. PREMBLY / PRIMEBLY (KYB & DIRECTOR BVN/NIN VERIFICATION)
# ------------------------------------------------------------------------------
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=your_prembly_api_key
PREMBLY_APP_ID=your_prembly_app_id

# ------------------------------------------------------------------------------
# 8. MAILERSEND (TRANSACTIONAL EMAILS & CONTRACTOR INVITES)
# ------------------------------------------------------------------------------
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_FROM_EMAIL=noreply@paycrew.io
MAILERSEND_FROM_NAME=PayCrew

# ------------------------------------------------------------------------------
# 9. YELLOWCARD (ALTERNATIVE STABLECOIN RAMP)
# ------------------------------------------------------------------------------
YELLOWCARD_BASE_URL=https://api.yellowcard.io/business/v1
YELLOWCARD_API_KEY=your_yellowcard_api_key
YELLOWCARD_WEBHOOK_SECRET=your_yellowcard_webhook_secret

# ------------------------------------------------------------------------------
# 10. SMILE ID & DOJAH (ALTERNATIVE IDENTITY VERIFICATION)
# ------------------------------------------------------------------------------
SMILE_ID_PARTNER_ID=sandbox_partner
SMILE_ID_API_KEY=your_smile_id_key
DOJAH_API_KEY=your_dojah_api_key
DOJAH_APP_ID=your_dojah_app_id

# ------------------------------------------------------------------------------
# 11. REDIS & BACKGROUND QUEUES (BULLMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 12. WEB3 / BLOCKCHAIN RPC NODES
# ------------------------------------------------------------------------------
BASE_RPC_URL=https://mainnet.base.org
TRON_RPC_URL=https://api.trongrid.io
